# URL base da API. Vazio = mesmo host (usa o proxy do Vite em dev e o gateway em producao).
VITE_API_BASE_URL=

# Alvo do proxy /api em desenvolvimento (backend Spring Boot).
VITE_PROXY_TARGET=http://localhost:8080

# true = usa fixtures locais (apenas em dev). false/ausente = consome a API real.
VITE_USE_MOCKS=false
